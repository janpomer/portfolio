---
import StyleGuideLayout from "../../layouts/StyleGuideLayout.astro";
import ColorSwatch from "../../components/style-guide/ColorSwatch.astro";
import css from "../../styles/global.css?raw";

// Read labels from the same source that supplies the live swatches.
const brandBlock = css.match(/@theme\s*\{([^}]+)\}/)?.[1] ?? "";
function valueOf(block: string, variable: string) {
  const value = block.match(new RegExp(`${variable}:\\s*([^;]+);`))?.[1].trim();
  if (!value) throw new Error(`Style guide cannot find ${variable} in global.css`);
  return value;
}
const brands = [
  { name: "Primary · Deep navy", variable: "--color-primary", usage: "Brand foundation and project image backgrounds." },
  { name: "Secondary · Medium blue", variable: "--color-secondary", usage: "Supporting blue and scrollbar treatment." },
  { name: "Accent · Teal", variable: "--color-accent", usage: "Calls to action, emphasis, links, and tags." },
];
const tokens = [
  { name: "Ink", token: "ink", usage: "Page background." },
  { name: "Surface", token: "surface", usage: "Raised panels and cards." },
  { name: "Haze", token: "haze", usage: "Body copy and secondary text." },
  { name: "Mist", token: "mist", usage: "Headings and primary text." },
  { name: "Line", token: "line", usage: "Subtle borders and dividers." },
  { name: "Veil", token: "veil", usage: "Hover fills and subtle overlays." },
];
const effects = [
  { name: "Image fade", variable: "--img-fade", usage: "Bottom gradient over project images." },
  { name: "Glow A", variable: "--glow-a", usage: "Teal tint in the page backdrop." },
  { name: "Glow B", variable: "--glow-b", usage: "Blue tint in the page backdrop." },
];
const themes = ["light", "dark"].map((theme) => ({
  name: theme,
  block: css.match(new RegExp(`\\[data-theme="${theme}"\\]\\s*\\{([^}]+)\\}`))?.[1] ?? "",
}));
---

<StyleGuideLayout title="Colors" description="A navy and teal foundation, with semantic colors that adapt to light and dark surfaces. Every swatch uses the portfolio’s existing CSS tokens.">
  <section aria-labelledby="brand" class="border-t border-line py-8">
    <h2 id="brand" class="text-xl font-semibold text-mist">Brand palette</h2>
    <p class="mt-2 mb-6 text-sm leading-relaxed">These three colors stay constant across both themes. Choose semantic text and surface tokens for everyday content.</p>
    <div class="brand-samples"><h3 class="sr-only">Shared brand colors</h3><ul class="grid gap-x-8 md:grid-cols-3">{brands.map((brand) => <ColorSwatch {...brand} value={valueOf(brandBlock, brand.variable)} />)}</ul></div>
  </section>
  <section aria-labelledby="themes" class="border-t border-line py-8">
    <h2 id="themes" class="text-xl font-semibold text-mist">Light &amp; dark palettes</h2>
    <p class="mt-2 mb-6 max-w-3xl text-sm leading-relaxed">Both samples keep their own theme when you switch the surrounding page. Transparent swatches are composited over each sample’s surface color; values retain their alpha channel.</p>
    <div class="grid items-start gap-6 lg:grid-cols-2">
      {themes.map((theme) => <section data-theme={theme.name} class="theme-sample" aria-labelledby={`${theme.name}-title`}>
        <h3 id={`${theme.name}-title`} class="mb-2 text-xl font-semibold capitalize">{theme.name}</h3>
        <p class="mb-6 text-sm leading-relaxed">Use <code>--color-*</code> utilities; these resolve through the theme’s <code>--c-*</code> values.</p>
        <ul>{tokens.map((token) => <ColorSwatch name={`${token.name} · --color-${token.token}`} variable={`--c-${token.token}`} value={valueOf(theme.block, `--c-${token.token}`)} usage={token.usage} />)}</ul>
        <h3 class="mt-6 mb-4 text-lg font-semibold">Supporting effects</h3>
        <ul>{effects.map((effect) => <ColorSwatch {...effect} value={valueOf(theme.block, effect.variable)} />)}</ul>
      </section>)}
    </div>
  </section>
  <section aria-labelledby="contrast" class="border-t border-line py-8">
    <h2 id="contrast" class="text-xl font-semibold text-mist">Contrast &amp; usage</h2>
    <p class="mt-3 max-w-3xl leading-relaxed">Use mist for headings and haze for body copy over ink or surface. Reserve line and veil for decoration; they are too subtle to carry information on their own. Pair state colors with text or an icon.</p>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed">The unchanged teal accent falls below 4.5:1 for small text on both themes’ ink and surface backgrounds. White text on the accent is also 4.43:1. Prefer mist or haze for small text, and check contrast when introducing new combinations.</p>
    <div class="mt-5 overflow-x-auto">
      <table class="w-full text-left text-sm leading-relaxed">
        <caption class="mb-3 text-left text-haze">Contrast ratios for the current solid colors (before overlays).</caption>
        <thead class="text-mist"><tr><th scope="col">Text</th><th scope="col">Light ink / surface</th><th scope="col">Dark ink / surface</th></tr></thead>
        <tbody>
          <tr><th scope="row">Haze</th><td>6.79 / 7.58</td><td>8.65 / 7.76</td></tr>
          <tr><th scope="row">Mist</th><td>14.22 / 15.86</td><td>18.88 / 16.93</td></tr>
          <tr><th scope="row">Accent</th><td>3.97 / 4.43</td><td>4.26 / 3.82</td></tr>
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm leading-relaxed">Source: src/styles/global.css · @theme, [data-theme="light"], and [data-theme="dark"]. Labels are read at build time; swatches render the live variables. Rebuild after changing tokens.</p>
  </section>
</StyleGuideLayout>

<style>
  .theme-sample { min-width: 0; border: 1px solid var(--c-line); border-radius: 1rem; padding: 1.5rem; background: var(--c-ink); color: var(--c-haze); }
  .theme-sample h3 { color: var(--c-mist); }
  th, td { padding: 0.75rem 0.5rem; border-bottom: 1px solid var(--color-line); }
  tbody th { color: var(--color-mist); font-weight: 500; }
</style>
